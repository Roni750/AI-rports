{
  "name": "airport-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "npm install && npm run doctor",
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test",
    "data:download": "python scripts/download_data.py",
    "data:build": "python scripts/build_dataset.py && python scripts/build_delays.py",
    "data:smoke": "tsx scripts/smoke-score.ts",
    "data:verify-tools": "tsx scripts/verify-tools.ts",
    "analytics:migrate": "tsx scripts/analytics-migrate.ts",
    "analytics:classify": "tsx scripts/classify-turns.ts",
    "analytics:seed": "tsx scripts/seed-analytics.ts",
    "analytics:entities": "tsx scripts/backfill-entities.ts",
    "analytics:prune": "tsx scripts/analytics-prune.ts",
    "eval:topics": "tsx scripts/eval-topics.ts",
    "models": "tsx scripts/list-models.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
