# Anthropic API key: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional override. The code default is claude-opus-5.
# If the chat reports that a model was not accepted, run `npm run models` to list what your key
# can actually use.
# ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Conversation analytics
# ---------------------------------------------------------------------------

# Where recorded conversations are stored. Defaults to a local SQLite file, which needs no setup.
# For a deployment, point this at a Turso database - libSQL speaks SQLite's dialect, so the schema
# and every query are identical either way:
#   turso db create airport-agent-analytics
#   turso db show --url airport-agent-analytics      -> ANALYTICS_DB_URL
#   turso db tokens create airport-agent-analytics   -> ANALYTICS_DB_TOKEN
# A serverless filesystem is ephemeral, so a file: URL will NOT persist writes on Vercel.
# ANALYTICS_DB_URL=file:data/analytics.db
# ANALYTICS_DB_TOKEN=

# Model for the fallback topic classifier. Deliberately not the model that answers questions: it is
# cheaper, and it keeps six months of topic history from moving when the chat model is swapped.
# CLASSIFIER_MODEL=claude-haiku-4-5

# Set to require ?token= on /analytics. Recorded prompts are user content; a public deployment
# should not publish them. REQUIRED in production: a production build with this unset serves the
# gate rather than the dashboard, so a forgotten variable cannot publish recorded prompts. Under
# `next dev` it stays open, so local work needs no ceremony.
# ANALYTICS_TOKEN=

# Signs the session id the chat endpoint hands back, so a caller cannot name another conversation's
# turn and overwrite it. Unset is safe but not free: a random key is generated per process, so
# conversations started before a restart are recorded under a new session id.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ANALYTICS_SESSION_SECRET=

# Stamped on every session so a behavioural change can be tied to a release.
# APP_VERSION=dev
