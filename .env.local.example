# Groq API key. Free tier: https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=gsk_your_key_here

# Optional override. The code default is openai/gpt-oss-120b.
# Provider model names get deprecated - Groq removed the Llama 3.x family, for instance - so if the
# chat reports that a model was not accepted, run `npm run models` to list what your key can use.
# GROQ_MODEL=openai/gpt-oss-120b
